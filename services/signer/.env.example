# Signer HTTP service port.
PORT=8091

# Signer mode.
# evm: build, sign, and broadcast real EVM transactions through EVM_RPC_URL.
# mock: return mock tx hash without broadcasting. Use only for development flow testing.
SIGNER_MODE=evm

# EVM RPC URL. For local Anvil use http://127.0.0.1:8545.
EVM_RPC_URL=http://127.0.0.1:8545

# Hot wallet address used for pending nonce lookup and gas estimation.
# It must match EVM_HOT_WALLET_PRIVATE_KEY.
EVM_HOT_WALLET_ADDRESS=

# Gas limit safety margin in basis points. 12000 = 120% of eth_estimateGas.
# Values below 10000 or above 30000 are rejected by the signer.
EVM_GAS_LIMIT_MULTIPLIER_BPS=12000

# EVM hot wallet private key used to sign withdrawals in local development.
# Never commit a real private key. Production key isolation is a separate P0 task.
EVM_HOT_WALLET_PRIVATE_KEY=
