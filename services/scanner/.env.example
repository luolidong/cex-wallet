# Scanner HTTP service port.
PORT=8092

# Java API base URL. Use http://localhost:8080 for local host startup.
API_BASE_URL=http://localhost:8080

# Internal token used when scanner calls Java internal APIs.
# Must match backend application.yml app.internal.token or INTERNAL_API_TOKEN.
INTERNAL_API_TOKEN=dev-internal-token

# Auto scan interval in seconds. Set 0 to disable auto loop and use manual /scan/* endpoints.
POLL_INTERVAL_SECONDS=3

# Development-only switch for /mock/deposits and /mock/cursors.
# Keep false for real local chain testing and production-like environments.
ENABLE_MOCK_ENDPOINTS=false
